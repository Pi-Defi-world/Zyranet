# ===========================================================================
# FreeRADIUS default site template for an approved campus authentication method.
#
# The selected access equipment sends Access-Request with an institutionally
# provisioned identity. rlm_sql + rlm_pap validate records in radcheck/radreply.
# Do not load legacy voucher records as current campus identities.
#
# TEMPLATE. If a full FreeRADIUS config already exists on your server, merge
# the authorize/authenticate sections; do not blindly overwrite.
# ===========================================================================

authorize {
    preprocess
    # Normalise NAS-Identifier etc.
    suffix
    chap
    mschap

    # Pull approved identity and policy records from Postgres.
    sql

    # Default deny; the sql module will set Auth-Type only if a row matches.
    if (!ok) {
        reject
    }

    #
    # Enforce the policy returned by the SQL reply attributes.
    #
    expiration
    logintime
    pap
}

authenticate {
    pap
    chap
    mschap
    # Digest requires a separately defined dictionary and secret.
}

post-auth {
    # Log every successful/failed auth to radpostauth.
    post-auth
    sql
}

preacct {
    preprocess
    acct_unique
    suffix
}

accounting {
    acct_unique
    detail
    sql
    # Null accounting for clients that send empty packets.
    exec
    if (!ok) {
        update reply { Acct-Session-Id := %{Acct-Session-Id} }
    }
}

session {
    sql
}

post-proxy {
    eap
}

pre-proxy {
    eap
}
