[Unit]
Description=Zyranet FastAPI service
After=network.target postgresql.service
Requires=postgresql.service

[Service]
Type=simple
User=zyranet
WorkingDirectory=/opt/zyranet
EnvironmentFile=/opt/zyranet/.env
ExecStart=/opt/zyranet/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
