# Minimal FreeRADIUS virtual server for PAP authentication against Postgres.
# Handles Access-Request and Accounting-Request for a configured NAS.
server default {
    listen {
        type = auth
        ipaddr = *
        port = 1812
    }
    listen {
        type = acct
        ipaddr = *
        port = 1813
    }

    authorize {
        preprocess
        # Pull approved identity and policy records from Postgres.
        sql
        # `pap` in authorize sets Auth-Type := PAP when User-Password is present.
        pap
    }

    authenticate {
        pap
    }

    post-auth {
        # sql logs every result to radpostauth.
        sql
    }

    preacct {
        preprocess
    }

    accounting {
        detail
        sql
    }

    session {
        sql
    }
}
