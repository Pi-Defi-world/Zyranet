# ===== Zyranet configuration =====
# Copy to `.env` and fill in real values. NEVER commit `.env`.

# --- Database (PostgreSQL — native on Linux Mint server) ---
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=zyranet
DB_USER=zyranet
DB_PASSWORD=CHANGE_ME
DB_URL=postgresql+asyncpg://zyranet:CHANGE_ME@127.0.0.1:5432/zyranet

# --- RADIUS (native FreeRADIUS on Linux Mint server) ---
# Shared secret between FreeRADIUS and the router. Long + random.
RADIUS_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET

# --- Telegram ---
TELEGRAM_BOT_TOKEN=000000:paste-your-token-here

# --- Payments ---
# Leave blank = dev mode (vouchers issued free, no payment gate).
# Fill in real keys = payment mode (bot sends checkout link before issuing voucher).
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_ENV=test
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
PAYSTACK_ENV=test

# --- SMS fallback (Termii) ---
TERMII_API_KEY=
TERMII_SENDER_ID=

# --- Network discovery / device tracking ---
SCAN_CIDRS=192.168.1.0/24
SCAN_INTERVAL_SECONDS=300
SCAN_ENABLED=true

# --- SNMP / LLDP (optional — managed switches only) ---
SNMP_ENABLED=false
SNMP_COMMUNITY=public
# JSON: [{"host":"10.10.20.5","community":"public","node_id":"sw-core"}]
SNMP_TARGETS=
TOPOLOGY_AUTO_EXPORT=true

# --- App ---
APP_HOST=0.0.0.0
APP_PORT=8000
ADMIN_JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
ADMIN_USER=admin
ADMIN_PASSWORD=CHANGE_ME
CURRENCY=NGN
PUBLIC_BASE_URL=http://192.168.1.2:8000
