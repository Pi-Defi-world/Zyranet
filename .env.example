# ===== Zyranet configuration =====
# Copy to `.env` and fill in real values. NEVER commit `.env`.

# --- Database (PostgreSQL) ---
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=zyranet
DB_USER=zyranet
DB_PASSWORD=CHANGE_ME
# Optional override. Leave blank for Compose, which assembles the URL from DB_*.
DB_URL=

# --- Optional RADIUS integration ---
# Configure only after confirming access-equipment compatibility and policy.
# RADIUS_SQL_* is used by deploy/render_secrets.py for a native RADIUS install.
RADIUS_SECRET=
RADIUS_SQL_USER=
RADIUS_SQL_PASSWORD=

# --- Network discovery / device tracking ---
# Discovery starts disabled. Add only approved, verified network ranges.
SCAN_CIDRS=
SCAN_INTERVAL_SECONDS=300
SCAN_ENABLED=false
SCAN_MAX_HOSTS_PER_SUBNET=1024
SCAN_MAX_HOSTS_TOTAL=4096
SCAN_SIGHTING_INTERVAL_SECONDS=3600

# --- SNMP / LLDP (optional — managed switches only) ---
SNMP_ENABLED=false
SNMP_COMMUNITY=
# JSON: [{"host":"10.10.20.5","community":"public","node_id":"sw-core"}]
SNMP_TARGETS=
TOPOLOGY_AUTO_EXPORT=false
# Per-walk timing (seconds) / retries and bounded discovery concurrency.
SNMP_TIMEOUT=2.0
SNMP_RETRIES=1
SNMP_MAX_CONCURRENT=8

# --- App ---
APP_HOST=0.0.0.0
APP_PORT=8000
APP_ENV=development
ADMIN_JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
ADMIN_USER=admin
ADMIN_PASSWORD=CHANGE_ME
# --- Security / HTTP hardening ---
# Role granted to the configured admin account: admin | operator | viewer.
ADMIN_ROLE=admin
# JWT lifetime and claims.
JWT_EXPIRE_MINUTES=720
JWT_ISSUER=zyranet
JWT_AUDIENCE=zyranet-admin
# Failed logins per (client IP, username) before a temporary lockout.
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=300
# Set true ONLY behind a reverse proxy that sets X-Forwarded-For.
TRUST_PROXY_HEADERS=false
# Development origin. Production must use the HTTPS dashboard origin.
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Development hosts. Production must list the proxy's concrete host names.
ALLOWED_HOSTS=*
# auto | json | text
LOG_FORMAT=auto

# --- Migrations (testing only) ---
# Used by backend/tests/test_migrations.py when set; leave unset to skip it.
# TEST_MIGRATION_DATABASE_URL=postgresql+asyncpg://zyranet:change-me@127.0.0.1:55432/zyranet
